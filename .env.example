# The dog's name, shown on PetAnalytics. Defaults to "your dog".
DOG_NAME=

# Home Wi-Fi camera, read directly by the local API. See "Home Wi-Fi camera" in MANAGER_SETUP.md.
# Tapo: rtsp://CAMERA_ACCOUNT_USERNAME:PASSWORD@CAMERA_IP:554/stream2
CAMERA_RTSP_URL=

# Optional camera speaker through go2rtc; npm run camera:speaker:setup fills these. See "Camera speaker" in MANAGER_SETUP.md.
GO2RTC_BIN=
GO2RTC_CONFIG=
GO2RTC_API_PASSWORD=
CAMERA_SPEAKER_STREAM=
# Defaults to http://127.0.0.1:1984.
GO2RTC_API=

# Optional settings for `npm run vision` (llama.cpp serving Liquid's vision model).
LLAMA_SERVER=
LIQUID_MODEL=
LIQUID_MMPROJ=
LIQUID_PORT=

# Nimble key for Find new sounds and live, source-linked alert guidance.
NIMBLE_API_KEY=

# Optional ffmpeg for the home camera and for decoding found recordings; defaults to ffmpeg on PATH.
FFMPEG_PATH=

# Tinybird keeps the dog diary, the sample-journal telemetry and the PetAnalytics log. npm run tinybird:setup deploys the tables to a
# workspace used only by DogMaAI and fills in the host and a token that can only add to and read them.
TINYBIRD_TOKEN=
# The workspace's regional API host, such as https://api.us-west-2.aws.tinybird.co.
TINYBIRD_API_URL=
# Telemetry table name; defaults to nightwatch_state_changes.
TINYBIRD_DATASOURCE=
# The Tinybird CLI used by npm run tinybird:setup; defaults to tb on PATH.
TINYBIRD_CLI=
# The workspace admin token, kept by npm run tinybird:setup after you paste it once, so later runs need no typing.
# Only the setup script reads it. It can change anything in the DogMaAI workspace, so keep .env private.
TINYBIRD_ADMIN_TOKEN=
