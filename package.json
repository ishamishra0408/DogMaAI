{
  "name": "dogmaai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "verify:demo": "tsx scripts/verify-demo.ts",
    "vision": "tsx scripts/vision-server.ts",
    "camera:setup": "tsx scripts/set-home-camera.ts",
    "camera:speaker:setup": "tsx scripts/set-camera-speaker.ts",
    "tinybird:setup": "tsx scripts/tinybird-setup.ts",
    "sound-model:setup": "tsx scripts/sound-model-setup.ts"
  },
  "dependencies": {
    "@nimble-way/nimble-js": "^1.5.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "latest",
    "dotenv": "^18.0.4",
    "express": "latest",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^3.2.4"
  }
}
